package com.kbo.project.board.service;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.kbo.project.common.CommonUtils;
import com.kbo.project.domain.Comment;
import com.kbo.project.dto.RegistComment;
import com.kbo.project.jwt.auth.JwtUtil;
import com.kbo.project.respository.BoardRepository;

import jakarta.servlet.http.Cookie;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Service
public class BoardService {

	@Autowired
	BoardRepository boardRepository;
	
	@Autowired
	JwtUtil jwtUtil;
	
	public Map<String, Object> boardDetail(long boardNo) {
		Map<String, Object> resultMap = new HashMap<String, Object>();
		
		resultMap.put("boardDetail", boardRepository.findById(boardNo));
		
		return resultMap;
	}

	public String registComment(RegistComment comment, HttpServletRequest request, HttpServletResponse response) {
		String userId = "";
		Comment commentDomain = new Comment();
		
		String result = jwtUtil.validateTokenLogic(request, response);
		System.out.println(result);
		
		if (!result.startsWith("Success")) {
		    return "Validation Fail";
		}
		
		for(Cookie cookie : request.getCookies()) {
			if(cookie.getName().equals("userId")) {
				userId = cookie.getValue().toString();
			}
		}
		System.out.println(userId);
        String dateFormat = CommonUtils.getNow();
        
		commentDomain.setUserId(userId);
		commentDomain.setBoardNo(comment.getBoardNo());
		commentDomain.setCommentContent(comment.getComments());
		commentDomain.setFrsRgtDtm(dateFormat);
		commentDomain.setLstAltDtm(dateFormat);
		
		return "Success";
	}
}