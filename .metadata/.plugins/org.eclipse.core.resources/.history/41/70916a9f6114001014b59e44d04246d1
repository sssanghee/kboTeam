package com.kbo.project.main.repository;

import java.util.List;

import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import com.kbo.project.main.domain.Board;
import com.kbo.project.teampage.dto.BoardInfo;

public interface BoardRepository extends JpaRepository<Board, Long> {
	@Query("SELECT b FROM Board b ORDER BY b.boardLike DESC")
	List<Board> findTop5ByOrderByBoardLikeDesc(Pageable pageable);

//	@Query("SELECT b FROM Board b WHERE b.teamNo = :teamNo ORDER BY b.boardLike DESC")
	@Query("SELECT com.kbo.project.teampage.dto.BoardInfo(b.boardNo, b.boardTitle, b.userId, b.frsRgtDtm) FROM Board b WHERE b.teamNo = :teamNo ORDER BY b.boardLike DESC")
	List<BoardInfo> findTop5ByIdOrderByBoardLikeDesc(Pageable pageable, @Param("teamNo") int teamNo);
}